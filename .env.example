# Solo se envían mensajes al detectar funciones, nunca cada minuto.
NOTIFIER=telegram
CHECK_INTERVAL_SECONDS=60
CONFIRMATIONS=2
PAGE_TIMEOUT_SECONDS=40
NOTIFY_RETRY_SECONDS=300
DATA_DIR=./data

# Telegram: token de BotFather y el ID de tu chat privado tras pulsar Iniciar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CallMeBot: tu número internacional y una clave activada para ese número.
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Alternativa oficial: NOTIFIER=meta. Requiere plantilla aprobada.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_TO=
META_GRAPH_VERSION=
META_TEMPLATE_NAME=cinema_alert
META_TEMPLATE_LANGUAGE=es

MOVIE_URL=https://rd.caribbeancinemas.com/plaza-internacional-santiago/movie/avengers-doomsday/
EXPECTED_TITLE=Avengers: Doomsday
EXPECTED_CINEMA=Plaza Internacional Santiago
